{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(*approve.sh*)",
      "Bash(*decide.mjs*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\" bash" }]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\" write" }]
      },
      {
        "matcher": "mcp__qase__.*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\" qase" }]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "case-judge|test-judge|skeptic|collector-.*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/agentic-workflows/functional-testing/scripts/record.mjs\"" }]
      }
    ]
  }
}
