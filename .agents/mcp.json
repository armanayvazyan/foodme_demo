{
  "mcpServers": {
    "qase": {
      "command": "npx",
      "args": [
        "-y",
        "@qase/mcp-server"
      ],
      "env": {
        "QASE_API_TOKEN": "${QASE_API_TOKEN}"
      }
    },
    "agentsecrets": {
      "command": "agentsecrets",
      "args": [
        "mcp",
        "serve"
      ]
    },
    "mcp-atlassian": {
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://foodme-armanayvazyan.atlassian.net",
        "JIRA_USERNAME": "ayvazyan.a.arman@gmail.com",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "glitchtip": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-glitchtip"
      ],
      "env": {
        "GLITCHTIP_TOKEN": "${GLITCHTIP_TOKEN}",
        "GLITCHTIP_ORGANIZATION": "foodme",
        "GLITCHTIP_BASE_URL": "https://app.glitchtip.com"
      }
    },
    "grafana": {
      "type": "http",
      "url": "https://foodme-monitoring.onrender.com/mcp"
    }
  }
}
