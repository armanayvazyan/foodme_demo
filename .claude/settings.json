{
  "permissions": {
    "allow": [
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(./gradlew test:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-actions.js" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-actions.js" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-bad-tests.js" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-commands.js" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bug-id-tracker.js" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-actions.js" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-edit.js" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bug-id-tracker.js" }
        ]
      }
    ]
  }
}
