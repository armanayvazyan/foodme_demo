{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(npm ci:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:e2e:*)",
      "Bash(./gradlew test:*)",
      "Bash(.agents/skills/run-regression/scripts/run-regression.sh:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./instructor/**)",
      "Read(./docs/planted-defects.md)"
    ]
  }
}
