{
    "mcpServers": {
        "playwright": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest",
                "--browser",
                "chrome",
                "--isolated"
            ]
        },
    
        "qase": {
            "command": "npx",
            "args": ["-y", "@qase/mcp-server"],
            "env": {
                "QASE_API_TOKEN": "${QASE_API_TOKEN}"
            }
        },
        
        "agentsecrets": {
            "command": "agentsecrets",
            "args": ["mcp", "serve"]
        },

        "mcp-atlassian": {
            "command": "uvx",
            "args": ["--python", "3.12", "mcp-atlassian"],
            "env": {
                "JIRA_URL": "https://artashesmkrtchyan09.atlassian.net/",
                "JIRA_USERNAME": "artashesmkrtchyan09@gmail.com",
                "JIRA_API_TOKEN": "${JIRA_OAUTH_TOKEN}"
            }
        }
    }
}